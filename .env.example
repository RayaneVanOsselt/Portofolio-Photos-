# ---------------------------------------------------------------------------
# rayvo.captures0808 — variables d'environnement (développement local)
# Copier ce fichier en .env.local (jamais commité).
# En ligne, la GitHub Action (.github/workflows/deploy.yml) fournit ces valeurs.
# ---------------------------------------------------------------------------

# URL publique du site, sans « / » final (canonical, sitemap, partages).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sous-dossier de publication (ex. /Portofolio-Photos-). Laisser vide en local.
NEXT_PUBLIC_BASE_PATH=

# Formulaire de contact — EmailJS (https://www.emailjs.com), voir README.
# Trois valeurs publiques par conception : elles permettent seulement d'envoyer
# vers votre adresse. Sans elles en local, le message est affiché dans la console.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Ancien réglage (Web3Forms), utilisé seulement si EmailJS n'est pas renseigné.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
