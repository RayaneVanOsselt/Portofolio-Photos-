# ---------------------------------------------------------------------------
# rayvo.captures0808 — variables d'environnement (développement local)
# Copier ce fichier en .env.local (jamais commité).
# En ligne, la GitHub Action (.github/workflows/deploy.yml) fournit ces valeurs.
# ---------------------------------------------------------------------------

# URL publique du site, sans « / » final (canonical, sitemap, partages).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sous-dossier de publication (ex. /Portofolio-Photos-). Laisser vide en local.
NEXT_PUBLIC_BASE_PATH=

# Clé d'accès Web3Forms (https://web3forms.com) pour le formulaire de contact.
# Publique par conception : elle permet seulement d'envoyer vers votre adresse.
# Sans clé en local, le message est affiché dans la console du navigateur.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
