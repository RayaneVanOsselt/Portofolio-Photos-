# ---------------------------------------------------------------------------
# Raï VO Capture 0808 — variables d'environnement
# Copier ce fichier en .env.local (jamais commité) et compléter les valeurs.
# ---------------------------------------------------------------------------

# URL publique du site, sans « / » final (canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.exemple.be

# --- Formulaire de contact (envoi via Resend — https://resend.com) ----------
# Clé API Resend (secrète : serveur uniquement, jamais exposée au navigateur).
RESEND_API_KEY=
# Destinataire(s) des demandes. Plusieurs adresses : séparer par des virgules.
EMAIL_TO=
# Expéditeur : une adresse d'un domaine vérifié dans Resend.
# Pour un premier test sans domaine : onboarding@resend.dev (n'envoie qu'à l'adresse du compte Resend).
EMAIL_FROM="Raï VO Capture 0808 <contact@exemple.be>"
