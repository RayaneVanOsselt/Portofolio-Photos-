# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# exemple de configuration (commité)
!.env.example

# outils locaux
.claude/settings.local.json

# déclinaisons WebP générées par npm run photos
/public/_photos/

# logos optimisés générés par npm run logos (sources : assets/logos/)
/public/logos/

# vidéos : jamais dans Git (GitHub refuse les fichiers > 100 Mo)
# motifs [xX] : insensibles à la casse aussi sur GitHub et Linux (.mp4 comme .MP4)
*.[mM][pP]4
*.[mM][oO][vV]
*.[mM]4[vV]
*.[wW][eE][bB][mM]
*.[aA][vV][iI]
*.[mM][kK][vV]
*.[mM][tT][sS]
*.[mM]2[tT][sS]
*.[wW][mM][vV]
*.[fF][lL][vV]
*.3[gG][pP]
*.[mM][pP][gG]
*.[mM][pP][eE][gG]

# macOS : icônes personnalisées de dossier (fichier « Icon » + retour chariot)
Icon?
